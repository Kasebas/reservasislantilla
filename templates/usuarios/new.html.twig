{% extends 'base.html.twig' %}

{% block title %}Nuevo Usuario{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card mt-4">
                <div class="card-header">
                    <h1 class="card-title">Crear Nuevo Usuario</h1>
                </div>
                <div class="card-body">
                    {{ include('usuarios/_form.html.twig') }}
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_usuarios_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver a la lista
