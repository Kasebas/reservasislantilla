<form method="post" action="{{ path('app_usuarios_delete', {'id': usuario.id}) }}" onsubmit="return confirm('¿Estás seguro de que quieres eliminar este usuario?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ usuario.id) }}">
    <button type="submit" class="btn btn-danger">
        <i class="fas fa-trash-alt"></i> Eliminar
    </button>
</form>
