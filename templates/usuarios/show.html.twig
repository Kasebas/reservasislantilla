{% extends 'base.html.twig' %}

{% block title %}Detalles del Usuario{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card mt-4">
                <div class="card-header">
                    <h1 class="card-title">Detalles del Usuario</h1>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            <tr>
                                <th scope="row">Id</th>
                                <td>{{ usuario.id }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Nombre de Usuario</th>
                                <td>{{ usuario.nombreUsuario }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Correo Electrónico</th>
                                <td>{{ usuario.email }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Contraseña</th>
                                <td>{{ usuario.contrasena }}</td>
                            </tr>
                            <tr>
                                <th scope="row">Rol de Usuario</th>
                                <td>{{ usuario.rolUsuario ? usuario.rolUsuario|join(', ') : '' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <a href="{{ path('app_usuarios_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i>&nbsp;Volver al Índice
                    </a>
                    <a href="{{ path('app_usuarios_edit', {'id': usuario.id}) }}" class="btn btn-warning">
                        <i class="fas fa-edit"></i>&nbsp;Editar Usuario
                    </a>
                    {{ include('usuarios/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
