{% extends 'base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Usuarios</h1>

        <a href="{{ path('app_usuarios_new') }}" class="btn btn-primary mb-3">
            <i class="fas fa-user-plus"></i> Crear Nuevo Usuario
        </a>

        <table class="table table-striped">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Nombre de Usuario</th>
                    <th scope="col">Email</th>
                    <th scope="col">Contraseña</th>
                    <th scope="col">Rol de Usuario</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for usuario in usuarios %}
                    <tr>
                        <td>{{ usuario.id }}</td>
                        <td>{{ usuario.nombreUsuario }}</td>
                        <td>{{ usuario.email }}</td>
                        <td>{{ usuario.contrasena }}</td>
                        <td>{{ usuario.rolUsuario }}</td>
                        <td>
                            <a href="{{ path('app_usuarios_show', {'id': usuario.id}) }}" class="btn btn-info btn-sm mr-1">
                                <i class="fas fa-eye"></i> Consultar
                            </a>
                            <a href="{{ path('app_usuarios_edit', {'id': usuario.id}) }}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Editar Usuario
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">No se ha encontrado usuarios</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <a href="{{ path('app_home') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver a la página de inicio
        </a>
    </div>
{% endblock %}
